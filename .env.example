# Optional Docker Compose overrides for the backend.
APP_NAME=O-AI API
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# OpenAI provider configuration. Keep this secret out of source control.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local-first conversation persistence.
OAI_DATABASE_URL=sqlite:///./data/oai.db
OAI_CHAT_CONTEXT_MESSAGE_LIMIT=20

# Optional Local AI runtime deployment configuration. Do not set OLLAMA_MODELS here.
OAI_LOCAL_AI_ENABLED=false
OAI_LOCAL_AI_BACKEND=ollama
OAI_LOCAL_AI_BASE_URL=http://127.0.0.1:11434
OAI_LOCAL_AI_MODEL=qwen3.5:9b
OAI_LOCAL_AI_TIMEOUT_SECONDS=120
OAI_LOCAL_AI_CONTEXT_LENGTH=4096

# First-party read-only Plugin connector. Availability still requires per-action owner approval.
OAI_GITHUB_PUBLIC_REPO_CONNECTOR_ENABLED=false

# D64 managed Google Calendar OAuth connector.
# Register the exact loopback redirect URI in Google Cloud Console.
OAI_GOOGLE_CALENDAR_CONNECTOR_ENABLED=false
# Relative Calendar Chat words such as "today" and "tomorrow" use this zone.
OAI_OWNER_TIMEZONE=Asia/Bangkok
# Fixed loopback frontend origin used only for OAuth callback UX redirects.
OAI_OWNER_UI_BASE_URL=http://localhost:3000
OAI_GOOGLE_OAUTH_CLIENT_ID=
OAI_GOOGLE_OAUTH_CLIENT_SECRET=
OAI_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google-calendar/callback
# Standard base64 encoding of exactly 32 random bytes; never commit a real key.
OAI_OAUTH_TOKEN_ENCRYPTION_KEY=

# Local-first document knowledge. Files are read only from this folder.
OAI_KNOWLEDGE_ROOT=./knowledge
OAI_DOCUMENT_MAX_FILE_SIZE_MB=50
OAI_CHUNK_SIZE_CHARS=2000
OAI_CHUNK_OVERLAP_CHARS=200
OAI_KNOWLEDGE_ANSWER_MAX_RETRIEVAL_QUERIES=3
OAI_KNOWLEDGE_ANSWER_CANDIDATES_PER_QUERY=12
OAI_KNOWLEDGE_ANSWER_SELECTED_EVIDENCE_COUNT=6
OAI_KNOWLEDGE_ANSWER_MAX_EVIDENCE_PER_DOCUMENT=2
OAI_KNOWLEDGE_ANSWER_CONTEXT_CHAR_BUDGET=8000

# Public API base URL used by the frontend container.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
